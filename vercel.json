{
  "version": 2,
  "framework": "vite",
  "ignoreCommand": "node scripts/vercel-ignore-build.js",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "DATA_BRANCH": "codex/step3b-layout",
    "VERCEL_PRODUCTION_BRANCH": "codex/step3b-layout",
    "CORS_ALLOWED_ORIGINS": "https://voetbalvoorspellingen-clean.vercel.app,https://voetbal-voorspellingen.vercel.app,https://voorspellingenprive.vercel.app"
  },
  "headers": [
    {
      "source": "/((?!assets/|.*\\.(?:js|mjs|css|map|json|webmanifest|png|jpg|jpeg|svg|ico|txt|xml|woff2?|ttf)$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/matches",   "destination": "/api/Matches"  },
    { "source": "/api/analyze",   "destination": "/api/analyze"  },
    { "source": "/api/standings", "destination": "/api/standings"},
    { "source": "/api/logo",      "destination": "/api/logo"     },
    { "source": "/api/status",    "destination": "/api/health"   },
    { "source": "/api/system-check", "destination": "/api/health" },
    { "source": "/api/systemHealth", "destination": "/api/health" },
    { "source": "/api/(.*)",      "destination": "/api/$1"       },
    { "source": "/((?!assets/|index\\.tsx|.*\\.(?:js|mjs|css|map|json|webmanifest|png|jpg|jpeg|svg|ico|txt|xml|woff2?|ttf)$).*)", "destination": "/index.html" }
  ]
}
