# FootyAI optional production integrations
# Leave values empty when you want the app to run in no-key mode.

# Real pre-match and closing odds.
ODDS_PROVIDER_NAME=
ODDS_API_SPORT=
ODDS_API_URL_TEMPLATE=
ODDS_API_KEY=
THE_ODDS_API_KEY=
API_KEY_API_FOOTBALL=
API_FOOTBALL_H2H_ENABLED=true
API_FOOTBALL_MAX_FETCHES_PER_RUN=20

# APIfootball.com Free: uitsluitend Championship en Ligue 2.
APIFOOTBALL_API_KEY=
APIFOOTBALL_MAX_REQUESTS_PER_RUN=20

# Nieuwe brede provider blijft 14 dagen achter de acceptatiegate.
GOAL_API_KEY=

# Optional football-data.org token for extra source depth.
FOOTBALL_DATA_TOKEN=
API_KEY_FOOTBALL_DATA=
FOOTBALL_DATA_TEAM_MAP=

# Optional external national-team Elo/FIFA feed URL (JSON).
NATIONAL_ELO_FEED_URL=

# Optional Postgres/Supabase connection for database/schema.sql.
DATABASE_URL=
POSTGRES_URL=
SUPABASE_DB_URL=

# Optional Cloudflare R2 dashboard cache and Web Analytics.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PREFIX=voetbalvoorspellingen/raw
DASHBOARD_R2_CACHE_ENABLED=false
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optionele handmatige Betfair Basic-exportmap voor offline kalibratie.
BETFAIR_HISTORY_INPUT_DIR=

# Health freshness window in minutes.
HEALTH_MAX_WORKER_AGE_MINUTES=180

# Optional free local model. Only enable this on a computer running Ollama.
FOOTYAI_OLLAMA_ENABLED=false
FOOTYAI_OLLAMA_URL=http://127.0.0.1:11434
FOOTYAI_OLLAMA_MODEL=llama3.2:3b

# Controlled writes. Operators may queue bounded repairs; admins may change controls.
FOOTYAI_OPERATOR_TOKEN=
FOOTYAI_ADMIN_TOKEN=
