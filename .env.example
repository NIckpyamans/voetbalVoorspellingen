# Kopieer dit bestand naar .env en vul de waarden lokaal in.
# .env staat in .gitignore; commit nooit een echte key.

# OddsPapi (odds voor de Nederlandse Eerste Divisie).
# Key staat op https://oddspapi.io/us/account achter "API Key" (kopieer-icoon).
ODDSPAPI_API_KEY=

# Optioneel: begrens een droogrun, en kies je bookmakerslugs uit
# Availability -> Bookmakers Access op de accountpagina.
# ODDSPAPI_DRYRUN_MAX_REQUESTS=5
# ODDSPAPI_BOOKMAKERS=bet99,bpremium
# ODDSPAPI_MIN_INTERVAL_MS=1100
